# Ignore Git metadata
.git
.gitignore

# VS / IDE files
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

# Build outputs
**/bin/
**/obj/
**/out/
**/publish/
*.nupkg

# Logs, temp files
*.log
*.tmp
*.cache

# Node/npm
node_modules/
npm-debug.log
yarn-error.log

# OS files
.DS_Store
Thumbs.db

# Environment / secrets
.env
*.local

# Large assets
*.zip
*.tar
*.gz
*.iso
*.mp4
*.mov

# Exclude Dockerfile intentionally kept (do not ignore)
